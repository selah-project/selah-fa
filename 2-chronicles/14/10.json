{"tier":"glm-5.2","verse":10,"ref":"2-chronicles 14:10","book":"2-chronicles","lang":"fa","chapter":14,"translation":"و آسا به سویِ یاهوه، الوهیمِ خود، فریاد برآورد، و گفت: یاهوه، ⟨که⟩ غیرِ تو یاری‌کننده‌ای نیست در میانِ فراوان به بی‌نیرو؛ ما را یاری ده، یاهوه الوهیمِ ما، که بر تو تکیه کرده‌ایم، و به نامِ تو بر این هامونِ فرا آمده‌ایم. یاهوه، الوهیمِ ما، تو ⟨هستی⟩؛ فرو مگذار با تو بایستد انسانی.","tokens":[{"surface":"וַיִּקְרָ֨א","gloss":"و فریاد برآورد"},{"surface":"אָסָ֜א","gloss":"آسا"},{"surface":"אֶל","gloss":"به سویِ"},{"surface":"יְהוָ֣ה","gloss":"یاهوه"},{"surface":"אֱלֹהָיו֮","gloss":"الوهیمِ"},{"surface":"וַיֹּאמַר֒","gloss":"و گفت"},{"surface":"יְהוָ֗ה","gloss":"یاهوه"},{"surface":"אֵֽין","gloss":"نیست"},{"surface":"עִמְּךָ֤","gloss":"با"},{"surface":"לַעְזוֹר֙","gloss":"تا یاری دهد"},{"surface":"בֵּ֥ין","gloss":"در میانِ"},{"surface":"רַב֙","gloss":"فراوان"},{"surface":"לְאֵ֣ין","gloss":"به بی‌"},{"surface":"כֹּ֔חַ","gloss":"نیرو"},{"surface":"עָזְרֵ֜נוּ","gloss":"ما را یاری ده"},{"surface":"יְהוָ֤ה","gloss":"یاهوه"},{"surface":"אֱלֹהֵ֨ינוּ֙","gloss":"الوهیمِ"},{"surface":"כִּֽי","gloss":"که"},{"surface":"עָלֶ֣יךָ","gloss":"بر"},{"surface":"נִשְׁעַ֔נּוּ","gloss":"تکیه کرده‌ایم"},{"surface":"וּבְשִׁמְךָ֣","gloss":"و به نامِ"},{"surface":"בָ֔אנוּ","gloss":"آمده‌ایم"},{"surface":"עַל","gloss":"بر"},{"surface":"הֶהָמ֖וֹן","gloss":"هامونِ"},{"surface":"הַזֶּ֑ה","gloss":"این"},{"surface":"יְהוָ֤ה","gloss":"یاهوه"},{"surface":"אֱלֹהֵ֨ינוּ֙","gloss":"الوهیمِ"},{"surface":"אַ֔תָּה","gloss":"تو"},{"surface":"אַל","gloss":"نه"},{"surface":"יַעְצֹ֥ר","gloss":"بایستد"},{"surface":"עִמְּךָ֖","gloss":"با"},{"surface":"אֱנֽוֹשׁ","gloss":"انسانی"}],"timestamp":"2026-08-13T23:47:09.484988147Z","model":"glm-5.2"}