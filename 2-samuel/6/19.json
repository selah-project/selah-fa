{"tier":"glm-5.2","verse":19,"ref":"2-samuel 6:19","book":"2-samuel","lang":"fa","chapter":6,"translation":"و به همهٔ قوم، به تمامیِ هجومِ ییسْرائیل، برای هر مرد و تا زن، بخشید؛ برای هر مرد یک گردینهٔ نان، و یک اِشْپار، و یک اَشی‌شه. و تمامیِ قوم رفت، هر مردی به خانهٔ خود.","tokens":[{"surface":"וַיְחַלֵּ֨ק","gloss":"و بخشید"},{"surface":"לְכָל","gloss":"به همهٔ"},{"surface":"הָעָ֜ם","gloss":"قوم"},{"surface":"לְכָל","gloss":"به تمامِ"},{"surface":"הֲמ֣וֹן","gloss":"هجومِ"},{"surface":"יִשְׂרָאֵל֮","gloss":"ییسْرائیل"},{"surface":"לְמֵאִ֣ישׁ","gloss":"برایِ هر مرد"},{"surface":"וְעַֽד","gloss":"و تا"},{"surface":"אִשָּׁה֒","gloss":"زن"},{"surface":"לְאִ֗ישׁ","gloss":"برایِ هر مرد"},{"surface":"חַלַּ֥ת","gloss":"گردینه"},{"surface":"לֶ֨חֶם֙","gloss":"نان"},{"surface":"אַחַ֔ת","gloss":"یک"},{"surface":"וְאֶשְׁפָּ֣ר","gloss":"و اِشْپار"},{"surface":"אֶחָ֔ד","gloss":"یکی"},{"surface":"וַאֲשִׁישָׁ֖ה","gloss":"و اَشی‌شه"},{"surface":"אֶחָ֑ת","gloss":"یک"},{"surface":"וַיֵּ֥לֶךְ","gloss":"و رفت"},{"surface":"כָּל","gloss":"تمامِ"},{"surface":"הָעָ֖ם","gloss":"قوم"},{"surface":"אִ֥ישׁ","gloss":"هر مرد"},{"surface":"לְבֵיתֽוֹ","gloss":"به خانهٔ خود"}],"timestamp":"2026-08-13T21:18:25.071183687Z","model":"glm-5.2"}