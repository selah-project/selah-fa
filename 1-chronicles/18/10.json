{"tier":"glm-5.2","verse":10,"ref":"1-chronicles 18:10","book":"1-chronicles","lang":"fa","chapter":18,"translation":"و ⟨את⟩ هَدورام پسرش را نزد پادشاه داوِد فرستاد، تا از او برای سلامت بپرسد و او را تبرک گوید، به‌خاطرِ آنکه با هَدَد‌عِزِر جنگیده و او را زده بود؛ زیرا هَدَد‌عِزِر مردِ جنگ‌هاییِ توعو بود. و تمامِ ظرف‌های زر و نقره و مس ⟨را نیز⟩.","tokens":[{"surface":"וישלח","gloss":"و فرستاد"},{"surface":"את","gloss":"⟨את⟩","marks":"هَدورام پسرش"},{"surface":"הדורם","gloss":"هَدورام"},{"surface":"בנו","gloss":"پسرش"},{"surface":"אל","gloss":"نزدِ"},{"surface":"המלך","gloss":"پادشاهِ"},{"surface":"דויד","gloss":"داوِد"},{"surface":"לשאול","gloss":"تا بپرسد"},{"surface":"לו","gloss":"از او"},{"surface":"לשלום","gloss":"برای سلامت"},{"surface":"ולברכו","gloss":"و تبرکِ او"},{"surface":"על","gloss":"به‌خاطرِ"},{"surface":"אשר","gloss":"آنکه"},{"surface":"נלחם","gloss":"جنگیده بود"},{"surface":"בהדדעזר","gloss":"با هَدَد‌عِزِر"},{"surface":"ויכהו","gloss":"و زده بود او را"},{"surface":"כי","gloss":"زیرا"},{"surface":"איש","gloss":"مردِ"},{"surface":"מלחמות","gloss":"جنگ‌هاییِ"},{"surface":"תעו","gloss":"توعو"},{"surface":"היה","gloss":"بود"},{"surface":"הדדעזר","gloss":"هَدَد‌عِزِر"},{"surface":"וכל","gloss":"و تمامِ"},{"surface":"כלי","gloss":"ظرف‌های"},{"surface":"זָהָ֥ב","gloss":"زر"},{"surface":"וכסף","gloss":"و نقره"},{"surface":"וּנְחֹֽשֶׁת","gloss":"و مس"}],"timestamp":"2026-08-13T23:40:36.049434338Z","model":"glm-5.2"}