{"tier":"glm-5.2","verse":7,"ref":"judges 18:7","book":"judges","lang":"fa","chapter":18,"translation":"و پنج مرد رفتند و به لایِش آمدند، و ⟨את⟩ قومِ آن‌جا را که در میانِ آن ساکن بود دیدند، بی‌خطر ساکن، چون رسمِ صیدونیان، آرام و مطمئن؛ و در زمین کسی نبود که چیزی آنان را خوار کند، با کتابتِ برق‌آسا، و از صیدونیان دور بودند، و کاری با هیچ‌کس نداشتند.","tokens":[{"surface":"וילכו","gloss":"و رفتند"},{"surface":"חמשת","gloss":"پنج"},{"surface":"האנשים","gloss":"مرد"},{"surface":"ויבאו","gloss":"و آمدند"},{"surface":"לישה","gloss":"به لایِش"},{"surface":"ויראו","gloss":"و دیدند"},{"surface":"את","gloss":"⟨את⟩","marks":"قوم را"},{"surface":"העם","gloss":"قوم"},{"surface":"אשר","gloss":"که"},{"surface":"בקרבה","gloss":"در میانِ آن"},{"surface":"יושבת","gloss":"ساکن"},{"surface":"לבטח","gloss":"بی‌خطر"},{"surface":"כמשפט","gloss":"چون رسمِ"},{"surface":"צדנים","gloss":"صیدونیان"},{"surface":"שקט","gloss":"آرام"},{"surface":"ובטח","gloss":"و مطمئن"},{"surface":"ואין","gloss":"و نبود"},{"surface":"מַכְלִ֨ים","gloss":"خوارِ"},{"surface":"דבר","gloss":"چیزی"},{"surface":"בארץ","gloss":"در زمین"},{"surface":"יורש","gloss":"با کتابتِ"},{"surface":"עצר","gloss":"برق‌آسا"},{"surface":"ורחקים","gloss":"و دور بودند"},{"surface":"המה","gloss":"آنها"},{"surface":"מצדנים","gloss":"از صیدونیان"},{"surface":"ודבר","gloss":"و کاری"},{"surface":"אין","gloss":"نداشتند"},{"surface":"להם","gloss":"برایشان"},{"surface":"עם","gloss":"با"},{"surface":"אדם","gloss":"هیچ‌کس"}],"timestamp":"2026-08-13T21:06:21.068218148Z","model":"glm-5.2"}